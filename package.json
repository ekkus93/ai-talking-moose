{
  "name": "talking-moose-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "generate:frontend-contract": "bash scripts/generate_frontend_contract.sh",
    "check:tauri-command-contract": "node scripts/check_tauri_command_contract.mjs",
    "check:frontend-contract-shapes": "node scripts/check_frontend_contract_shapes.mjs",
    "check:generated-backend-contract": "npm run generate:frontend-contract && git diff --exit-code -- src/generated/backendContract.json && npm run check:frontend-contract-shapes",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:all": "npm run check:frontend && npm run check:rust && npm run check:generated-backend-contract",
    "check:frontend": "npm run check:generated-trees && npm run check:tauri-command-contract && npm run check:frontend-contract-shapes && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "check:generated-trees": "node scripts/check_generated_trees_untracked.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
