# Generated by Cargo
# will have compiled files and executables
# (bare "debug" removed: it matched node_modules/debug too, not just target/debug,
# which target/ already covers)
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore that can
#  be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Generated macOS Moonshine native runtime staging
src-tauri/native/macos/*.dylib
src-tauri/native/macos/notices/THIRD_PARTY_NOTICES.md
src-tauri/native/macos/notices/MoonshineRuntime/
src-tauri/native/macos/notices/Dependencies/
# Deterministically generated application icons
src-tauri/icons/*.png
src-tauri/icons/*.icns
src-tauri/icons/*.ico

# Vite/Vitest caches under the (otherwise tracked) node_modules tree.
# These rewrite on every dev server start and test run, so tracking them
# leaves the working tree permanently dirty and blocks `git pull --rebase`.
node_modules/.vite/

# Platform-specific optional native binaries resolved at install time.
# The glibc variants are tracked; these musl duplicates are ~20MB of
# native blobs that only appear on musl hosts and are not shipped.
node_modules/@rollup/rollup-linux-x64-musl/
node_modules/@tauri-apps/cli-linux-x64-musl/

run_opencode*.sh*
run_claude*.sh*
*~
